{
  "name": "drivegram",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "tsx watch server/index.ts",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "package:embedded": "node scripts/build-embedded-server.js",
    "postinstall": "node scripts/patch-nodejs-mobile.js",
    "desktop:dev": "concurrently \"npm run server\" \"tauri dev\"",
    "desktop:build": "npm run build && npm run package:embedded && tauri build",
    "tauri": "tauri",
    "mobile:build-frontend": "npm run build",
    "mobile:sync": "npm run mobile:build-frontend && npm run package:embedded && npx cap sync android",
    "mobile:open": "npx cap open android",
    "mobile:apk": "npm run mobile:sync && cd android && gradlew assembleDebug && cd .. && copy /Y android\\app\\build\\outputs\\apk\\debug\\app-debug.apk DriveGram.apk"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@red-mobile/nodejs-mobile-cordova": "^3.4.2",
    "@tauri-apps/api": "^2.11.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "epubjs": "^0.3.93",
    "express": "^4.19.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.395.0",
    "multer": "^1.4.5-lts.1",
    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "^3.11.174",
    "postcss": "^8.4.38",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^3.4.4",
    "telegram": "^2.22.2",
    "tsx": "^4.15.1",
    "typescript": "^5.4.5",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "esbuild": "^0.25.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.0"
  }
}
