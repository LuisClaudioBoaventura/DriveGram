{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DriveGram",
  "version": "1.10.0",
  "identifier": "com.drivegram.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run ensure:desktop-node && npm run build && npm run package:embedded"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DriveGram",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../www/nodejs-project/**/*",
      "bin/node.exe"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwQjJCMDUwRjExRDc3NkQKUldSdGR4M3hVTEN5c04wbVNQQUtXbllBVmxoS21YR08wQkZCS1d6UGFvNy9IdlZMaTFZSnc4MGUK",
      "endpoints": [
        "https://github.com/LuisClaudioBoaventura/DriveGram/releases/latest/download/latest.json"
      ]
    }
  }
}
